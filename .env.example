# ==========================================
# MORELOGIN TELEGRAM BOT CONFIGURATION
# ==========================================

# 1. Telegram Bot Token from @BotFather
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# 2. Admin Telegram IDs (separated by commas for multiple admins)
# To find your ID, message @userinfobot on Telegram
ADMIN_IDS=123456789

# 3. Email Settings
# The bot uses https://www.muellfach.de/
DEFAULT_EMAIL_PREFIX=priyaahmed210208

# 4. Default Password (min 8 chars, numbers + letters)
DEFAULT_PASSWORD=MoreLogin@2026!

# 5. Realtime Admin Push Notifications (true/false)
# When true, admin gets an instant Telegram alert whenever ANY user clicks a button
REALTIME_ADMIN_PUSH=true

# 6. Built-in Web Admin Dashboard (true/false)
ENABLE_WEB_DASHBOARD=true
WEB_DASHBOARD_PORT=8080
